# Copy this file to .env.local and fill in real values.

# --- Sanity (headless CMS) ---
# Create a free project at https://www.sanity.io/manage, then paste the
# Project ID and dataset name here. Until these are set, every page falls
# back to the local seed content in src/lib/content/seed.ts (see
# src/lib/sanity/fetch.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Analytics (requirement 12.2) ---
NEXT_PUBLIC_GA4_ID=

# --- Content seed script only (scripts/seed-taxonomy.mjs) ---
# NOT read by the running app — only used locally, once, to push the 3
# Pillars/9 Systems/Profile into Sanity. Get a write-scoped token at
# sanity.io/manage -> project -> API -> Tokens -> "Add API token" (Editor
# permission). Never commit a real token here.
SANITY_API_TOKEN=

