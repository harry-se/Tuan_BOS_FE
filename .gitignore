# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev data store (leads/orders/newsletter) — not for production use, see README
/.data/

# sanity
.sanity/

# standalone Sanity Studio project (own node_modules/build, see studio/README or root README)
studio/node_modules/
studio/dist/
studio/.sanity/
studio/.env

# typescript
*.tsbuildinfo
next-env.d.ts
/.claude
